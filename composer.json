{
    "name": "angelcruz/thatseoagent",
    "description": "Lightweight SEO without the bloat.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Angel Cruz"
        }
    ],
    "require": {
        "php": ">=8.3",
        "league/html-to-markdown": "^5.1.2"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/wp-cli-stubs": "^2.11",
        "php-stubs/woocommerce-stubs": "^11.1",
        "laravel/pint": "^1.32"
    },
    "autoload-dev": {
        "psr-4": {
            "ThatSeoAgent\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "ThatSeoAgent\\Dependencies\\",
            "classmap_prefix": "ThatSeoAgent_Dependencies_",
            "constant_prefix": "THATSEOAGENT_DEPENDENCIES_",
            "delete_vendor_packages": true,
            "exclude_from_copy": {
                "file_patterns": [
                    "#^league/html-to-markdown/(?!src/|LICENSE$)#"
                ]
            }
        }
    },
    "scripts": {
        "prefix-namespaces": [
            "@php bin/strauss.phar",
            "@composer dump-autoload"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ],
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint",
        "lint": "pint --test"
    }
}
