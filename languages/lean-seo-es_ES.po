msgid "Lean SEO"
msgstr ""

#. Plugin URI of the plugin
#: lean-seo.php
msgid "https://github.com/Sarai-Chinwag/lean-seo"
msgstr ""

#. Description of the plugin
#: lean-seo.php
msgid ""
"Lightweight SEO without the bloat. Meta tags, Open Graph, Schema markup, XML "
"sitemaps, per-post SEO fields, and Markdown for AI agents. A Yoast "
"replacement that doesn't slow your site down."
msgstr ""

#. Author of the plugin
#: lean-seo.php
msgid "Sarai Chinwag"
msgstr ""

#. Author URI of the plugin
#: lean-seo.php
msgid "https://saraichinwag.com"
msgstr ""

#: includes/class-lean-seo-abilities.php:22
msgid "Get Sitemap URLs"
msgstr "Obtener URLs de sitemaps"

#: includes/class-lean-seo-abilities.php:23
msgid "Returns a list of sitemap URLs generated by Lean SEO."
msgstr "Devuelve la lista de URLs de sitemaps generadas por Lean SEO."

#: includes/class-lean-seo-abilities.php:54
msgid "Get Post SEO"
msgstr "Obtener SEO de la entrada"

#: includes/class-lean-seo-abilities.php:55
msgid "Returns SEO data for a specific post."
msgstr "Devuelve los datos SEO de una entrada concreta."

#: includes/class-lean-seo-abilities.php:72
msgid "Post ID to retrieve SEO data for."
msgstr "ID de la entrada de la que obtener los datos SEO."

#: includes/class-lean-seo-abilities.php:99
msgid "Audit Post SEO"
msgstr "Auditar SEO de la entrada"

#: includes/class-lean-seo-abilities.php:100
msgid "Analyzes a post for SEO issues and returns recommendations."
msgstr ""
"Analiza una entrada en busca de problemas de SEO y devuelve recomendaciones."

#: includes/class-lean-seo-abilities.php:117
msgid "Post ID to audit."
msgstr "ID de la entrada a auditar."

#: includes/class-lean-seo-abilities.php:163
msgid "Scan SEO Issues"
msgstr "Escanear problemas de SEO"

#: includes/class-lean-seo-abilities.php:164
msgid "Scans multiple posts for SEO issues and returns a summary."
msgstr ""
"Escanea varias entradas en busca de problemas de SEO y devuelve un resumen."

#: includes/class-lean-seo-abilities.php:181
msgid "Maximum posts to scan (default: 50)."
msgstr "Máximo de entradas a escanear (por defecto: 50)."

#: includes/class-lean-seo-abilities.php:186
msgid "Minimum issues to include in results (default: 1)."
msgstr "Mínimo de problemas para incluir en los resultados (por defecto: 1)."

#: includes/class-lean-seo-abilities.php:211
msgid "Update Post SEO"
msgstr "Actualizar SEO de la entrada"

#: includes/class-lean-seo-abilities.php:212
msgid "Updates SEO meta for a specific post."
msgstr "Actualiza los metadatos SEO de una entrada concreta."

#: includes/class-lean-seo-abilities.php:234
msgid "Post ID to update."
msgstr "ID de la entrada a actualizar."

#: includes/class-lean-seo-abilities.php:238
msgid "Custom SEO title. Empty string clears the value."
msgstr "Título SEO personalizado. Una cadena vacía borra el valor."

#: includes/class-lean-seo-abilities.php:242
msgid "Custom meta description. Empty string clears the value."
msgstr "Meta descripción personalizada. Una cadena vacía borra el valor."

#: includes/class-lean-seo-abilities.php:320
#: includes/class-lean-seo-abilities.php:355
#: includes/class-lean-seo-abilities.php:384
msgid "Post ID is required."
msgstr "El ID de la entrada es obligatorio."

#: includes/class-lean-seo-abilities.php:325
#: includes/class-lean-seo-abilities.php:360
#: includes/class-lean-seo-abilities.php:389
msgid "No post exists with that ID."
msgstr "No existe ninguna entrada con ese ID."

#: includes/class-lean-seo-abilities.php:445
msgid "Title is too short (under 30 characters)"
msgstr "El título es demasiado corto (menos de 30 caracteres)"

#: includes/class-lean-seo-abilities.php:453
msgid "Title may be truncated in search results (over 60 characters)"
msgstr ""
"El título puede aparecer cortado en los resultados de búsqueda (más de 60 "
"caracteres)"

#: includes/class-lean-seo-abilities.php:464
msgid "Meta description is too short (under 100 characters)"
msgstr "La meta descripción es demasiado corta (menos de 100 caracteres)"

#: includes/class-lean-seo-abilities.php:472
msgid "Meta description may be truncated (over 160 characters)"
msgstr "La meta descripción puede aparecer cortada (más de 160 caracteres)"

#: includes/class-lean-seo-abilities.php:483
msgid "Content is very thin (under 300 words)"
msgstr "El contenido es muy escaso (menos de 300 palabras)"

#: includes/class-lean-seo-abilities.php:491
msgid "Content is relatively short (under 800 words)"
msgstr "El contenido es más bien corto (menos de 800 palabras)"

#: includes/class-lean-seo-abilities.php:502
msgid "No H2 headings found - consider adding structure"
msgstr "No se han encontrado encabezados H2: conviene añadir estructura"

#: includes/class-lean-seo-abilities.php:513
msgid "No internal links - consider linking to related content"
msgstr "Sin enlaces internos: conviene enlazar a contenido relacionado"

#: includes/class-lean-seo-abilities.php:524
msgid "No images in content"
msgstr "El contenido no tiene imágenes"

#: includes/class-lean-seo-abilities.php:535
msgid "Some images are missing alt text"
msgstr "Algunas imágenes no tienen texto alternativo"

#: includes/class-lean-seo-admin.php:29
msgid "Schema / Publisher Defaults"
msgstr "Schema / Valores por defecto del editor"

#: includes/class-lean-seo-admin.php:31
msgid "Fallback author used when a post has no WordPress author assigned."
msgstr ""
"Autor de reserva que se usa cuando una entrada no tiene autor de WordPress "
"asignado."

#: includes/class-lean-seo-admin.php:37
msgid "Author Name"
msgstr "Nombre del autor"

#: includes/class-lean-seo-admin.php:38
msgid "Author URL"
msgstr "URL del autor"

#: includes/class-lean-seo-admin.php:39
msgid "Author Type"
msgstr "Tipo de autor"

#: includes/class-lean-seo-admin.php:137
msgid "Lean SEO Settings"
msgstr "Ajustes de Lean SEO"

#: includes/class-lean-seo-admin.php:192
msgid "🔍 SEO Settings"
msgstr "🔍 Ajustes de SEO"

#: includes/class-lean-seo-admin.php:248
msgid "SEO Title"
msgstr "Título SEO"

#: includes/class-lean-seo-admin.php:259
msgid "Leave blank to use the post title. Recommended: 50-60 characters."
msgstr ""
"Déjalo en blanco para usar el título de la entrada. Recomendado: 50-60 "
"caracteres."

#: includes/class-lean-seo-admin.php:264
msgid "Meta Description"
msgstr "Meta descripción"

#: includes/class-lean-seo-admin.php:272
msgid "Leave blank to auto-generate from content..."
msgstr ""
"Déjalo en blanco para generarla automáticamente a partir del contenido..."

#: includes/class-lean-seo-admin.php:275
msgid "Recommended: 150-160 characters. This appears in search results."
msgstr ""
"Recomendado: 150-160 caracteres. Es lo que aparece en los resultados de "
"búsqueda."

#: includes/class-lean-seo-homepage.php:59
msgid "Homepage SEO"
msgstr "SEO de la portada"

#: includes/class-lean-seo-homepage.php:61
msgid ""
"Customize the title and meta description for the homepage. Leave blank to "
"use WordPress defaults."
msgstr ""
"Personaliza el título y la meta descripción de la portada. Déjalo en blanco "
"para usar los valores por defecto de WordPress."

#: includes/class-lean-seo-homepage.php:62
msgid "Available variables:"
msgstr "Variables disponibles:"

#: includes/class-lean-seo-homepage.php:70
msgid "Homepage Title"
msgstr "Título de la portada"

#: includes/class-lean-seo-homepage.php:78
msgid "Homepage Description"
msgstr "Descripción de la portada"

#: includes/class-lean-seo-homepage.php:101
msgid "Recommended: 50-60 characters. Leave blank to use the site name."
msgstr ""
"Recomendado: 50-60 caracteres. Déjalo en blanco para usar el nombre del "
"sitio."

#: includes/class-lean-seo-homepage.php:122
msgid ""
"Recommended: 150-160 characters. Appears in search results and social shares "
"for the homepage."
msgstr ""
"Recomendado: 150-160 caracteres. Aparece en los resultados de búsqueda y al "
"compartir la portada en redes."

#: includes/class-lean-seo-identity.php:41
msgid "Twitter / X"
msgstr "Twitter / X"

#: includes/class-lean-seo-identity.php:42
msgid "GitHub"
msgstr "GitHub"

#: includes/class-lean-seo-identity.php:43
msgid "Facebook"
msgstr "Facebook"

#: includes/class-lean-seo-identity.php:44
msgid "LinkedIn"
msgstr "LinkedIn"

#: includes/class-lean-seo-identity.php:45
msgid "Instagram"
msgstr "Instagram"

#: includes/class-lean-seo-identity.php:46
msgid "YouTube"
msgstr "YouTube"

#: includes/class-lean-seo-identity.php:47
msgid "Mastodon"
msgstr "Mastodon"

#: includes/class-lean-seo-identity.php:123
msgid "Site Identity"
msgstr "Identidad del sitio"

#: includes/class-lean-seo-identity.php:125
msgid ""
"Tell search engines who this site represents. These values populate Open "
"Graph meta tags and JSON-LD schema (Person or Organization)."
msgstr ""
"Indica a los buscadores a quién representa este sitio. Estos valores "
"alimentan las etiquetas Open Graph y el schema JSON-LD (Person u "
"Organization)."

#: includes/class-lean-seo-identity.php:131
msgid "Identity Type"
msgstr "Tipo de identidad"

#: includes/class-lean-seo-identity.php:132
msgid "Name"
msgstr "Nombre"

#: includes/class-lean-seo-identity.php:133
msgid "Description / Bio"
msgstr "Descripción / Biografía"

#: includes/class-lean-seo-identity.php:134
msgid "Logo / Photo"
msgstr "Logotipo / Foto"

#: includes/class-lean-seo-identity.php:135
msgid "Default OG Image"
msgstr "Imagen OG por defecto"

#: includes/class-lean-seo-identity.php:136
msgid "Twitter @handle"
msgstr "@usuario de Twitter"

#: includes/class-lean-seo-identity.php:137
msgid "Social Profiles"
msgstr "Perfiles sociales"

#: includes/class-lean-seo-identity.php:162
msgid "Person"
msgstr "Persona"

#: includes/class-lean-seo-identity.php:166
msgid "Organization"
msgstr "Organización"

#: includes/class-lean-seo-identity.php:168
msgid "Determines whether the site outputs Person or Organization schema."
msgstr "Determina si el sitio emite schema de tipo Person u Organization."

#: includes/class-lean-seo-identity.php:185
msgid "@username"
msgstr "@usuario"

#: includes/class-lean-seo-identity.php:186
msgid "Used as twitter:site on social cards. The leading @ is optional."
msgstr ""
"Se usa como twitter:site en las tarjetas sociales. La @ inicial es opcional."

#: includes/class-lean-seo-identity.php:189
msgid "The name of the person or organization this site represents."
msgstr "El nombre de la persona u organización que representa este sitio."

#: includes/class-lean-seo-identity.php:219
msgid "Short bio or organization description used in schema output."
msgstr ""
"Biografía breve o descripción de la organización que se usa en el schema."

#: includes/class-lean-seo-identity.php:235
msgid ""
"Used in Person/Organization schema output. Separate from the theme Site Logo."
msgstr ""
"Se usa en el schema Person/Organization. Es independiente del logotipo del "
"tema."

#: includes/class-lean-seo-identity.php:237
msgid "Fallback Open Graph image for posts without a featured image."
msgstr "Imagen Open Graph de reserva para entradas sin imagen destacada."

#: includes/class-lean-seo-identity.php:252
msgid "Select Image"
msgstr "Seleccionar imagen"

#: includes/class-lean-seo-identity.php:253
msgid "Remove"
msgstr "Quitar"

#: includes/class-lean-seo-identity.php:286
msgid ""
"Emitted as sameAs links in schema so search engines can link your site to "
"these profiles."
msgstr ""
"Se emiten como enlaces sameAs en el schema para que los buscadores asocien "
"tu sitio con estos perfiles."

#: includes/class-lean-seo-indexnow.php:115
msgid "IndexNow"
msgstr "IndexNow"

#: includes/class-lean-seo-indexnow.php:117
msgid ""
"Notify Bing, Yandex and other IndexNow engines whenever a post is published "
"or updated. Leave the key blank to disable."
msgstr ""
"Avisa a Bing, Yandex y otros buscadores compatibles con IndexNow cada vez "
"que se publica o actualiza una entrada. Deja la clave en blanco para "
"desactivarlo."

#: includes/class-lean-seo-indexnow.php:124
msgid "API Key"
msgstr "Clave de API"

#: includes/class-lean-seo-indexnow.php:149
msgid "8–128 characters, letters, numbers and dashes only."
msgstr "De 8 a 128 caracteres: solo letras, números y guiones."

#: includes/class-lean-seo-indexnow.php:151
msgid "Suggested key:"
msgstr "Clave sugerida:"

#: includes/class-lean-seo-indexnow.php:153
msgid "Verification file:"
msgstr "Archivo de verificación:"

#: includes/class-lean-seo-indexnow.php:155
msgid "(served automatically by this plugin)"
msgstr "(lo sirve automáticamente este plugin)"

#: includes/class-lean-seo-indexnow.php:192
msgid "The IndexNow key must be between 8 and 128 characters."
msgstr "La clave de IndexNow debe tener entre 8 y 128 caracteres."

#: includes/class-lean-seo-indexnow.php:271
msgid "IndexNow API key not configured."
msgstr "La clave de API de IndexNow no está configurada."

#. translators: %d: HTTP status code returned by the IndexNow API.
#: includes/class-lean-seo-indexnow.php:305
#, php-format
msgid "IndexNow API returned %d"
msgstr "La API de IndexNow devolvió %d"

