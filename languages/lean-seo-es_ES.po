#. Description of the plugin
#: lean-seo.php
msgid ""
"Lightweight SEO without the bloat. Meta tags, Open Graph, Schema markup, XML"
" sitemaps, per-post SEO fields, and Markdown for AI agents. A Yoast "
"replacement that doesn't slow your site down."
msgstr ""

#. Author of the plugin
#: lean-seo.php
msgid "Sarai Chinwag"
msgstr ""

#. Author URI of the plugin
#: lean-seo.php
