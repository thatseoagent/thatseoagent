msgstr[1] "La navegación del sitio enlaza a %d páginas que no existen"

#. translators: %s: the addresses, comma-separated.
#: includes/bulletin/class-thatseoagent-bulletin.php:343
#, php-format
msgid ""
"The menus, header or footer point to %s, which answer \"not found\". "
