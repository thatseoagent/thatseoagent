parameters:
	ignoreErrors:
		-
			message: '#^Offset ''id'' does not exist on array\{label\: string, destination\: ''edit_post''\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: includes/admin/class-thatseoagent-app.php

		-
			message: '#^Offset ''id'' on array\{label\: string, destination\: ''edit_post''\} in empty\(\) does not exist\.$#'
			identifier: empty.offset
			count: 1
			path: includes/admin/class-thatseoagent-app.php

		-
			message: '#^Ternary operator condition is always false\.$#'
			identifier: ternary.alwaysFalse
			count: 1
			path: includes/admin/class-thatseoagent-app.php

		-
			message: '#^Offset ''dot'' does not exist on array\{square\: string, field\: string\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: includes/admin/views/dashboard.php

		-
			message: '#^Parameter \#1 \$text of function esc_attr expects string, float given\.$#'
			identifier: argument.type
			count: 1
			path: includes/admin/views/products.php

		-
			message: '#^Parameter \#1 \$query of method WP_HTML_Tag_Processor\:\:next_tag\(\) expects array\{tag_name\?\: string\|null, match_offset\?\: int\|null, class_name\?\: string\|null, tag_closers\?\: string\|null\}\|null, ''img'' given\.$#'
			identifier: argument.type
			count: 1
			path: includes/audit/class-thatseoagent-audit.php

		-
			message: '#^Offset ''navigation_broken'' on array\{built\: int, inbound\: array\<int, int\>, navigation\: array\<int, bool\>, broken\: array\<int, array\<int, string\>\>, unchecked\: array\<int, int\>, navigation_broken\: array\<int, string\>, navigation_unchecked\: int\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: includes/audit/class-thatseoagent-links.php

		-
			message: '#^Offset ''navigation_unchecked'' on array\{built\: int, inbound\: array\<int, int\>, navigation\: array\<int, bool\>, broken\: array\<int, array\<int, string\>\>, unchecked\: array\<int, int\>, navigation_broken\: array\<int, string\>, navigation_unchecked\: int\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: includes/audit/class-thatseoagent-links.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(WP_Post\)\: mixed\)\|null, ''intval'' given\.$#'
			identifier: argument.type
			count: 1
			path: includes/audit/class-thatseoagent-links.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: includes/catalog/class-thatseoagent-product.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$gallery_key$#'
			identifier: parameter.notFound
			count: 1
			path: includes/catalog/class-thatseoagent-product.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: includes/content/class-thatseoagent-faq.php

		-
			message: '#^Parameter \#1 \$query of method WP_HTML_Tag_Processor\:\:next_tag\(\) expects array\{tag_name\?\: string\|null, match_offset\?\: int\|null, class_name\?\: string\|null, tag_closers\?\: string\|null\}\|null, ''img'' given\.$#'
			identifier: argument.type
			count: 1
			path: includes/content/class-thatseoagent-image.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: includes/content/class-thatseoagent-primary-term.php

		-
			message: '#^Instanceof between WP_Post and WP_Post will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: includes/content/class-thatseoagent-primary-term.php

		-
			message: '#^Cannot unset offset ''post_format'' on array\<int, string\>\.$#'
			identifier: unset.offset
			count: 1
			path: includes/content/class-thatseoagent-term-seo.php

		-
			message: '#^Parameter \#2 \$args of function register_block_type expects array\{api_version\?\: string, title\?\: string, category\?\: string\|null, parent\?\: array\<string\>\|null, ancestor\?\: array\<string\>\|null, allowed_blocks\?\: array\<string\>\|null, icon\?\: string\|null, description\?\: string, \.\.\.\}, array\{api_version\: 3, title\: string, description\: string, category\: ''theme'', icon\: ''arrow\-right\-alt2'', keywords\: array\{''breadcrumb'', ''migas'', ''navigation''\}, editor_script\: ''thatseoagent…'', attributes\: array\{separator\: array\{type\: ''string'', default\: ''›''\}\}, \.\.\.\} given\.$#'
			identifier: argument.type
			count: 1
			path: includes/head/class-thatseoagent-breadcrumbs.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: includes/head/class-thatseoagent-schema.php

		-
			message: '#^Action callback returns bool\|WP_Error but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: includes/integrations/class-thatseoagent-indexnow.php

		-
			message: '#^Parameter \#2 \$user_id of function get_the_author_meta expects int\|false, string given\.$#'
			identifier: argument.type
			count: 1
			path: includes/markdown/class-thatseoagent-markdown.php

		-
			message: '#^Instanceof between WP_User and WP_User will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: includes/site/class-thatseoagent-author-profile.php

		-
			message: '''
				#^PHPDoc tag @return has invalid value \(array\{@type\: string, name\: string, url\: string\}\|null Null when
				        no default author is set\.\)\: Unexpected token "@type", expected type at offset 126 on line 5$#
			'''
			identifier: phpDoc.parseError
			count: 1
			path: includes/site/class-thatseoagent-default-author.php

		-
			message: '#^Parameter \#1 \$text of function esc_attr expects string, int given\.$#'
			identifier: argument.type
			count: 1
			path: includes/site/class-thatseoagent-identity.php

		-
			message: '#^Method ThatSeoAgent_Sitemap\:\:get_cpts\(\) should return array\<int, string\> but returns array\<string, string\>\.$#'
			identifier: return.type
			count: 1
			path: includes/sitemap/class-thatseoagent-sitemap.php
